# Configuración de desarrollo local. No contiene credenciales reales.
APP_ENV=development
APP_DEBUG=false

# Genera una clave estable con secrets.token_hex(32) y colócala en tu .env.
# En production se exige una clave aleatoria de al menos 32 caracteres.
SECRET_KEY=

# HTTP local: false. Para producción con HTTPS, usa true.
SESSION_COOKIE_SECURE=false
# En producción: pos.tudominio.com,localhost,127.0.0.1 (sin esquema ni puerto).
TRUSTED_HOSTS=

DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=puntocom_pos
DB_CONNECT_TIMEOUT=5
# Servidor remoto: verify-full y certificado CA; red Docker privada: disable.
DB_SSLMODE=prefer
DB_SSLROOTCERT=
