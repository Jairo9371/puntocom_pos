# Plantilla para las variables de Vercel. No contiene credenciales reales.
# Copiar los valores al proyecto de Vercel; no subir un archivo con secretos.
APP_ENV=production
APP_DEBUG=false
SESSION_COOKIE_SECURE=true

# Generar una clave aleatoria estable de al menos 32 caracteres.
SECRET_KEY=
# Vercel agrega sus dominios exactos mediante las variables del sistema.
# Agregar aquí los dominios propios, separados por comas y sin https://.
# Para ejecutar mantenimiento local con esta plantilla: TRUSTED_HOSTS=localhost
TRUSTED_HOSTS=

DB_HOST=db.example.invalid
DB_PORT=5432
DB_NAME=puntocom_pruebas
DB_USER=puntocom_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
# Ajustar TLS y CA según el proveedor PostgreSQL.
DB_SSLMODE=verify-full
# Ruta del certificado CA, si corresponde; debe existir también en el despliegue.
DB_SSLROOTCERT=
