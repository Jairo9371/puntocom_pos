# Copia a deployment/.env en el servidor; chmod 600. Nunca subir al repositorio.
POS_DOMAIN=pos.example.invalid
ACME_EMAIL=administracion@example.invalid
# Genera TRES valores aleatorios diferentes (secrets.token_hex(32)). Sin ejemplos reutilizables.
SECRET_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DB_NAME=puntocom_pos
WEB_WORKERS=2
# En servidor, ruta absoluta privada: mkdir -m 700 /srv/puntocom-backups
BACKUP_DIR=/srv/puntocom-backups
